{
  "version": 1,
  "apply": {
    "enabled": false,
    "persistent": true,
    "debounceMs": 1200
  },
  "profiles": [
    {
      "id": "desk-laptop-closed",
      "name": "Desk — laptop closed",
      "match": {
        "mode": "exact",
        "monitors": [
          "Example External Monitor A",
          "Example External Monitor B"
        ]
      },
      "assignments": {
        "Example External Monitor A": [
          1,
          2,
          3
        ],
        "Example External Monitor B": [
          4,
          5,
          6
        ]
      },
      "labels": {
        "1": "💻",
        "4": "🌐"
      },
      "divider": "|"
    },
    {
      "id": "default",
      "name": "Default",
      "match": {
        "mode": "default"
      },
      "assignments": {},
      "labels": {},
      "divider": "|",
      "fallback": {
        "perMonitor": 3
      }
    }
  ]
}
